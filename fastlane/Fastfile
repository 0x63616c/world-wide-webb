require "shellwords"
require_relative "lib/apple_account"
require_relative "lib/release_operations"

def repository_root
  File.expand_path("..", __dir__)
end

def apple_destination
  sh("python3", File.join(repository_root, "scripts/apple-build-environment.py"), log: false).strip
end

def generate_project
  sh("xcodegen", "generate", "--spec", File.join(repository_root, "apps/ios/project.yml"))
end

def run_app_verification
  destination = apple_destination
  generate_project
  run_tests(
    project: File.join(repository_root, "apps/ios/Folding.xcodeproj"),
    scheme: "Folding",
    configuration: "Debug",
    destination: destination,
    derived_data_path: File.join(repository_root, "build/ios"),
    output_directory: File.join(repository_root, "build/test-results"),
    result_bundle: true,
    parallel_testing: false,
    concurrent_workers: 1,
    skip_slack: true,
    xcodebuild_formatter: ""
  )
end

default_platform(:ios)
platform :ios do
  desc "Enable required capabilities on Folding identifiers; preserve existing services"
  lane :configure_capabilities do
    begin
      UI.message(JSON.pretty_generate(FoldingAppleAccount.configure_capabilities))
    rescue StandardError => error
      UI.user_error!("Apple capability setup failed (#{error.class}); inspect inventory before retrying")
    end
  end

  desc "Read Folding Apple app and bundle registration state without changing it"
  lane :apple_inventory do
    begin
      result = FoldingAppleAccount.inventory
      UI.message(JSON.pretty_generate(result))
    rescue StandardError => error
      UI.user_error!("Apple inventory failed (#{error.class}); credentials and raw responses are suppressed")
    end
  end

  desc "Idempotently register isolated production/staging app and widget bundle IDs"
  lane :register_bundles do
    begin
      result = FoldingAppleAccount.register_bundles
      UI.message(JSON.pretty_generate(result))
    rescue StandardError => error
      UI.user_error!("Apple registration failed (#{error.class}); inspect inventory before retrying")
    end
  end

  desc "Run contract/core checks and the app-hosted Duo simulator persistence test"
  lane :verify do
    sh(File.join(repository_root, "scripts/check"))
    run_app_verification
  end

  desc "Run the app-hosted Duo simulator check (core checks are a separate prerequisite)"
  lane :verify_app do
    run_app_verification
  end

  desc "Capture the complete local App Store matrix without Apple credentials"
  lane :screenshots do |options|
    apple_destination
    generate_project
    record = FoldingRelease::LocalCaptureRecord.new(environment: options[:environment] || "production")
    FoldingRelease::Assets.metadata(record) unless File.exist?(File.join(record.directory, "assets/metadata-manifest.json"))
    FoldingRelease::Assets.capture(self, record)
  end

  desc "Reserve a globally monotonic build and immutable draft release record"
  lane :reserve do |options|
    FoldingRelease.reserve(tag: options.fetch(:tag), environment: options[:environment] || "production", version: options.fetch(:version))
  end

  desc "Check current evidence/backend/pages; final:true also checks processed release assets"
  lane :release_preflight do |options|
    FoldingRelease::Operations.preflight(FoldingRelease::Record.new(options.fetch(:tag)), options.fetch(:evidence), final: options[:final] == true || options[:final] == "true")
  end

  desc "Capture and seal metadata/screenshots into immutable release artifacts"
  lane :release_assets do |options|
    apple_destination
    generate_project
    FoldingRelease::Operations.assets(self, FoldingRelease::Record.new(options.fetch(:tag)))
  end

  desc "Create one signed archive using readonly match; reuse its immutable artifacts on retry"
  lane :archive do |options|
    apple_destination
    generate_project
    FoldingRelease::Operations.archive(self, FoldingRelease::Record.new(options.fetch(:tag)))
  end

  desc "Upload the exact IPA and distribute its processed build to explicit TestFlight groups"
  lane :beta do |options|
    FoldingRelease::Operations.beta(self, FoldingRelease::Record.new(options.fetch(:tag)))
  end

  desc "Submit the exact reviewed production build and verify Apple review state"
  lane :submit do |options|
    FoldingRelease::Operations.submit(self, FoldingRelease::Record.new(options.fetch(:tag)), options.fetch(:evidence))
  end

end
