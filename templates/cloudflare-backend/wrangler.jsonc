{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "__SLUG__-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-08",
  "workers_dev": false,
  "preview_urls": false,
  "env": {
    "staging": {
      "name": "__SLUG__-api-staging",
      "vars": { "ENVIRONMENT": "staging", "RELEASE_REVISION": "development" }
    },
    "production": {
      "name": "__SLUG__-api-production",
      "vars": { "ENVIRONMENT": "production", "RELEASE_REVISION": "unreleased" }
    }
  }
}
