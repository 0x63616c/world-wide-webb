#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
case "${1:-all}" in
  --staged)
    cargo fmt --all -- --check
    python3 -m compileall -q tools deploy/mini
    ;;
  rust)
    cargo fmt --all -- --check
    cargo clippy --workspace --all-targets -- -D warnings
    cargo test --workspace
    ;;
  ops)
    python3 -m unittest discover -s deploy/mini -p 'test_*.py'
    python3 -m unittest discover -s tools -p 'test_data_migration.py'
    ;;
  apple)
    swift test --package-path apple/Packages/PanelKit
    ;;
  integration)
    cargo build -p www-server --locked
    python3 tools/test_native_api.py
    ;;
  all)
    bash tools/check rust
    bash tools/check ops
    bash tools/check apple
    bash tools/check integration
    ;;
  *) echo 'Usage: tools/check [rust|ops|apple|integration|--staged|all]' >&2; exit 64 ;;
esac
