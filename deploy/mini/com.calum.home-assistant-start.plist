<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<key>Label</key>
	<string>com.calum.home-assistant-start</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>/Users/calum/home-assistant/start-ha.sh</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>/Users/calum/home-assistant/startup-error.log</string>
	<key>StandardOutPath</key>
	<string>/Users/calum/home-assistant/startup.log</string>
	<key>ThrottleInterval</key>
	<integer>30</integer>
</dict>
</plist>
