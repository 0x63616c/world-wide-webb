#!/usr/bin/env bash
# Product-owned checks behind one local entrypoint. Never publishes or activates hosts.
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
cd "$root"

usage() {
  cat << 'HELP'
Usage: scripts/dev <command>
  list                         List projects
  setup <project>              Install the project's declared tools and dependencies
  new <Name> <bundle-suffix> [--backend cloudflare]   Create an independent app
  check <project>              Run the project's local checks
  homelab [planner|activation|backup|all]...  Run focused local homelab tests
  affected <base> [options]    Resolve affected apps (verification by default)
  doctor                       Check shared local tools without signing in

Checks use each product's existing handler. Standard iOS apps run core tests when
present and an unsigned simulator build. These are local checks, not release proof.
See docs/NEW-APP.md and docs/DEVELOPMENT.md for account setup and delivery.
HELP
}
fail() {
  printf 'error: %s\n' "$*" >&2
  exit 64
}
command_name=${1:-help}
if (($#)); then shift; fi
case "$command_name" in
  help | --help | -h) usage ;;
  list | apps)
    (($# == 0)) || fail 'list takes no arguments'
    for dir in projects/*; do
      [[ -f "$dir/README.md" ]] && basename "$dir"
    done
    ;;
  setup)
    (($# == 1)) || fail 'setup needs one project name'
    project=$1
    [[ "$project" =~ ^[a-z][a-z0-9-]*$ && -f "projects/$project/README.md" ]] || fail "unknown project: $project"
    command -v mise > /dev/null || fail 'install mise to use the pinned project tools'
    (cd "projects/$project" && mise install)
    case "$project" in
      folding) exec bash projects/folding/scripts/bootstrap ;;
      control-center) exec bash projects/control-center/tools/setup ;;
      tendr) exec bundle install ;;
      homelab)
        command -v nix > /dev/null || fail 'install Nix to work on homelab hosts'
        exec nix develop projects/homelab --command true
        ;;
      *) printf 'Project tools ready: %s\n' "$project" ;;
    esac
    ;;
  homelab)
    exec python3 scripts/homelab/dev_check.py "$@"
    ;;
  new)
    (($# == 2 || $# == 4)) || fail 'new needs <Name> <bundle-suffix> [--backend cloudflare]'
    exec bash scripts/new-app.sh "$@"
    ;;
  affected)
    (($# > 0)) || fail 'affected needs a base revision'
    exec scripts/affected --intent verify "$@"
    ;;
  doctor)
    (($# == 0)) || fail 'doctor takes no arguments'
    missing=0
    for tool in git mise ruby bundle python3 bun cargo swift xcodegen xcrun; do
      if command -v "$tool" > /dev/null 2>&1; then
        printf 'Available: %s\n' "$tool"
      else
        printf 'Missing: %s\n' "$tool"
        missing=1
      fi
    done
    if python3 -c 'import yaml' > /dev/null 2>&1; then
      printf 'Available: Python PyYAML\n'
    else
      printf 'Missing: Python PyYAML (activate an environment with scripts/requirements.txt)\n'
      missing=1
    fi
    printf 'Product pins and runtime/account readiness are checked by their own workflows.\n'
    exit "$missing"
    ;;
  check)
    (($# == 1)) || fail 'check needs exactly one project'
    app=$1
    [[ "$app" =~ ^[a-z][a-z0-9-]*$ ]] || fail 'use a project name from scripts/dev list'
    if [[ "$app" == homelab ]]; then
      python3 scripts/homelab/dev_check.py all
      exec python3 scripts/homelab/check_nix.py
    fi
    [[ -f "projects/$app/app.yml" && ! -L "projects/$app" ]] || fail "unknown app: $app"
    if [[ -f "projects/$app/backend/wrangler.jsonc" ]]; then
      (cd "projects/$app/backend" && bun install --frozen-lockfile && bun run check)
    fi
    handler=$(ruby scripts/app-config.rb "$app" delivery_handler)
    case "$handler" in
      standard_ios)
        # Manifest values are command arguments, never shell fragments.
        project=$(ruby scripts/app-config.rb "$app" project_path)
        scheme=$(ruby scripts/app-config.rb "$app" scheme)
        package_tests=$(ruby scripts/app-config.rb "$app" swift_package)
        [[ "$package_tests" == true || "$package_tests" == false ]] || fail "$app: swift_package must be true or false"
        if [[ "$package_tests" == true ]]; then
          swift test --package-path "projects/$app"
        fi
        (cd "projects/$app" && xcodegen generate --quiet)
        exec xcodebuild -project "$project" -scheme "$scheme" \
          -destination 'generic/platform=iOS Simulator' \
          -derivedDataPath "$root/build/local/$app" CODE_SIGNING_ALLOWED=NO build
        ;;
      folding) exec bash projects/folding/scripts/check ;;
      callkeep) exec bash projects/callkeep/Scripts/test.sh ;;
      control_center) exec bash projects/control-center/tools/check ;;
      *) fail "no local check handler for $app ($handler)" ;;
    esac
    ;;
  *)
    usage >&2
    fail "unknown command: $command_name"
    ;;
esac
