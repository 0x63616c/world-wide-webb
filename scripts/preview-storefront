#!/usr/bin/env python3
"""Render one draft marketing frame from an existing capture, without booting a simulator."""
import argparse
import json
from pathlib import Path
import subprocess
import tempfile

ROOT = Path(__file__).resolve().parents[1]
parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('capture', type=Path)
parser.add_argument('output', type=Path)
parser.add_argument('--locale', default='en-US')
parser.add_argument('--scene', choices=['today', 'history', 'patterns', 'leaderboard', 'milestones'], default='today')
parser.add_argument('--display', choices=['duo-outer', 'duo-inner', 'iphone-medium'], default='duo-outer')
args = parser.parse_args()
plan = json.loads((ROOT / 'fastlane/screenshot-plan.json').read_text())
copy = json.loads((ROOT / 'fastlane/metadata-source.json').read_text())['locales'][args.locale]
scene = next(s for s in plan['scenarios'] if s['id'] == args.scene)
display = next(d for d in plan['devices'] + plan['additional_upload_slots'] if d['id'].startswith(args.display))
args.output.parent.mkdir(parents=True, exist_ok=True)
with tempfile.TemporaryDirectory(prefix='folding-frame-') as temporary:
    renderer = Path(temporary) / 'compose'
    subprocess.run(['swiftc', str(ROOT / 'fastlane/scripts/compose-screenshot.swift'), '-o', str(renderer)], check=True)
    subprocess.run([str(renderer), str(args.capture.resolve()), str(args.output.resolve()),
                    str(display['pixel_width']), str(display['pixel_height']), copy['captions'][args.scene],
                    copy['eyebrows'][args.scene], scene['appearance'], str(ROOT / 'fastlane/screenshot-frame.json')], check=True)
print(f'Draft frame: {args.output}. Preview only; not release capture evidence.')
