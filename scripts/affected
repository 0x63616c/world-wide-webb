#!/usr/bin/env python3
"""Resolve app impact from committed changes. Requires PyYAML (scripts/requirements.txt)."""
import argparse
import fnmatch
import json
from pathlib import Path
import subprocess

import yaml

ROOT = Path(__file__).resolve().parent.parent


def git(*args):
    return subprocess.check_output(["git", *args], cwd=ROOT, stderr=subprocess.DEVNULL)


def usable(ref):
    return bool(ref and set(ref) != {"0"} and subprocess.run(
        ["git", "cat-file", "-e", f"{ref}^{{commit}}"], cwd=ROOT,
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0)


def resolve_base(base):
    if usable(base):
        return base
    try:
        return git("merge-base", "HEAD", "origin/main").decode().strip()
    except subprocess.CalledProcessError:
        # A main checkout without remote history can still compare its last commit.
        if git("branch", "--show-current").decode().strip() == "main" and usable("HEAD~1"):
            return "HEAD~1"
        raise SystemExit("No usable base or origin/main merge-base; fetch main history first")


def ignored(path):
    parts = Path(path).parts
    return (path.endswith(".md") or "docs" in parts or
            Path(path).name in {"screenshots.json", "README.md", "AGENTS.md"} or
            (len(parts) > 2 and parts[0] == "apps" and parts[2] == "fastlane"))


def tooling(path):
    return (path in {"fastlane/Fastfile", "fastlane/Appfile"} or
            path.startswith(("Gemfile", "scripts/", ".github/workflows/", ".github/actions/")))


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("base", nargs="?", default="")
    parser.add_argument("--intent", required=True, choices=["verify", "ship"])
    parser.add_argument("--only", help="Keep apps with this enabled app.yml capability")
    parser.add_argument("--head", help="Compare this committed tree instead of HEAD and working-tree configuration")
    args = parser.parse_args()
    head = args.head or "HEAD"
    if args.head and not usable(head):
        parser.error("--head must name an available commit")
    configs = {}
    config_paths = ([ROOT / path for path in git("ls-tree", "-r", "--name-only", head, "apps").decode().splitlines()
                     if len(Path(path).parts) == 3 and path.endswith("/app.yml")]
                    if args.head else sorted(ROOT.glob("apps/*/app.yml")))
    for config_path in config_paths:
        config = yaml.safe_load(git("show", f"{head}:{config_path.relative_to(ROOT)}") if args.head else config_path.read_text())
        for key in ("uses", "paths"):
            values = config.get(key, [])
            if not isinstance(values, list) or not all(isinstance(v, str) and v for v in values):
                parser.error(f"{config_path}: {key} must be a list of nonempty strings")
        for package in config.get("uses", []):
            package_exists = (bool(git("ls-tree", "-d", "--name-only", head, f"packages/{package}"))
                              if args.head else (ROOT / "packages" / package).is_dir())
            if not package_exists or "/" in package or package in {".", ".."}:
                parser.error(f"{config_path}: unknown package {package}")
        for pattern in config.get("paths", []):
            if pattern.startswith("/") or ".." in pattern.split("/"):
                parser.error(f"{config_path}: paths must be repo-relative globs")
        configs[config_path.parent.name] = config
    base = resolve_base(args.base)
    files = git("diff", "--no-renames", "--name-only", "-z", base, head).decode().split("\0")
    files = [path for path in files if path and not ignored(path)]
    if args.intent == "ship":
        # Adding impact declarations does not change a binary. Other app.yml edits
        # (version, signing, scheme, etc.) retain their existing shipping behavior.
        for app in configs:
            path = f"apps/{app}/app.yml"
            if path not in files:
                continue
            try:
                before = yaml.safe_load(git("show", f"{base}:{path}"))
                after = yaml.safe_load(git("show", f"{head}:{path}"))
            except subprocess.CalledProcessError:
                continue  # A new app config is a real app change.
            if all(isinstance(config, dict) for config in (before, after)):
                binary_config = lambda config: {k: v for k, v in config.items() if k not in {"uses", "paths"}}
                if binary_config(before) == binary_config(after):
                    files.remove(path)
    build_tooling = any(tooling(path) for path in files)
    apps = []
    for app, config in configs.items():
        # This is the standard iOS handler's resolver. Other products use the
        # repository unit selector and their own build/release state machines.
        if config.get("delivery_handler", "standard_ios") != "standard_ios":
            continue
        if args.intent == "ship" and config.get("testflight") is not True:
            continue
        if args.only and not config.get(args.only):
            continue
        patterns = [f"apps/{app}/**", *config.get("paths", []),
                    *(f"packages/{package}/**" for package in config.get("uses", []))]
        if ((args.intent == "verify" and build_tooling) or
                any(fnmatch.fnmatchcase(path, pattern) for path in files for pattern in patterns)):
            apps.append(app)
    verify = args.intent == "verify"
    rdesign = any(path.startswith(("apps/tendr/Packages/RDesign/", "packages/RDesign/")) for path in files)
    legacy_rdesign = any(path.startswith("packages/RDesign/") for path in files)
    template = any(path.startswith("templates/") for path in files)
    print(json.dumps({"apps": apps, "rdesign": verify and (rdesign or build_tooling),
                      "template": verify and (template or legacy_rdesign or build_tooling)}, separators=(",", ":")))


if __name__ == "__main__":
    main()
