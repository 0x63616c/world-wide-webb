#!/usr/bin/env python3
"""Resolve app impact from committed changes. Requires PyYAML (scripts/requirements.txt)."""

import argparse
import importlib.util
import json
from pathlib import Path
import subprocess

import yaml

ROOT = Path(__file__).resolve().parent.parent


def git(*args):
    return subprocess.check_output(["git", *args], cwd=ROOT, stderr=subprocess.DEVNULL)


def usable(ref):
    return bool(
        ref
        and set(ref) != {"0"}
        and subprocess.run(
            ["git", "cat-file", "-e", f"{ref}^{{commit}}"],
            cwd=ROOT,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        ).returncode
        == 0
    )


def resolve_base(base):
    if usable(base):
        return base
    try:
        return git("merge-base", "HEAD", "origin/main").decode().strip()
    except subprocess.CalledProcessError:
        # A main checkout without remote history can still compare its last commit.
        if git("branch", "--show-current").decode().strip() == "main" and usable("HEAD~1"):
            return "HEAD~1"
        raise SystemExit("No usable base or origin/main merge-base; fetch main history first")


def ignored(path):
    parts = Path(path).parts
    return (
        path.endswith(".md")
        or "docs" in parts
        or Path(path).name in {"screenshots.json", "README.md", "AGENTS.md"}
        or (len(parts) > 2 and parts[0] == "projects" and parts[2] in {"fastlane", "site"})
    )


def tooling(path):
    return path in {"fastlane/Fastfile", "fastlane/Appfile"} or path.startswith(
        ("Gemfile", "scripts/", ".github/workflows/", ".github/actions/")
    )


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("base", nargs="?", default="")
    parser.add_argument("--intent", required=True, choices=["verify", "ship", "preview"])
    parser.add_argument("--force", action="store_true", help="Verify every standard product without publication")
    parser.add_argument("--head", help="Compare this committed tree instead of HEAD and working-tree configuration")
    args = parser.parse_args()
    if args.force and args.intent not in {"verify", "preview"}:
        parser.error("--force is verification-only")
    head = args.head or "HEAD"
    if args.head and not usable(head):
        parser.error("--head must name an available commit")
    configs = {}
    config_paths = (
        [
            ROOT / path
            for path in git("ls-tree", "-r", "--name-only", head, "projects").decode().splitlines()
            if len(Path(path).parts) == 3 and path.endswith("/app.yml")
        ]
        if args.head
        else sorted(ROOT.glob("projects/*/app.yml"))
    )
    for config_path in config_paths:
        configs[config_path.parent.name] = yaml.safe_load(
            git("show", f"{head}:{config_path.relative_to(ROOT)}") if args.head else config_path.read_text()
        )
    base = resolve_base(args.base)
    files = git("diff", "--no-renames", "--name-only", "-z", base, head).decode().split("\0")
    files = [path for path in files if path and not ignored(path)]
    spec = importlib.util.spec_from_file_location("unit_selection", ROOT / "scripts/ci/select_units.py")
    shared = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(shared)
    manifest = (
        yaml.safe_load(git("show", f"{head}:scripts/ci/units.json"))
        if args.head
        else json.loads(shared.CONFIG.read_text())
    )
    selected = shared.select(files, manifest, force=args.force)
    standard_units = {
        f"{app}.native" for app, config in configs.items() if config.get("delivery_handler") == "standard_ios"
    }
    # Shared tooling verifies the standard apps only when one of them is selected with it;
    # repo.tooling and the other products' tooling have their own checks.
    build_tooling = bool(
        args.force
        or selected["shared_tooling"]
        or selected["unmapped"]
        or (any(tooling(path) for path in files) and standard_units.intersection(selected["verify"]))
    )
    apps = []
    for app, config in configs.items():
        # This is the standard iOS handler's resolver. Other products use the
        # repository unit selector and their own build/release state machines.
        if config.get("delivery_handler") != "standard_ios":
            continue
        direct = any(path.startswith(f"projects/{app}/") for path in files)
        if args.intent == "ship":
            chosen = config.get("testflight") is True and f"{app}.native" in selected["delivery_candidates"] and direct
        elif args.intent == "preview":
            chosen = args.force or selected["standard_preview"] or f"{app}.native" in selected["previews"] or direct
        else:
            chosen = build_tooling or direct
        if chosen:
            apps.append(app)
    print(json.dumps({"apps": apps}, separators=(",", ":")))


if __name__ == "__main__":
    main()
