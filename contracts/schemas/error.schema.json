{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://getfolding.app/contracts/v1/error.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "minimum_ios_build": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "code": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    },
    "request_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "retryable": {
      "type": "boolean"
    },
    "retry_after_seconds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 86400
    }
  },
  "required": [
    "code",
    "request_id",
    "retryable"
  ]
}
