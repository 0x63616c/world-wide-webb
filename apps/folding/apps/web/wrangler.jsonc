{
  "name": "folding-web-staging",
  "compatibility_date": "2026-11-07",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist-staging",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "env": {
    "production": {
      "name": "folding-web-production",
      "workers_dev": false,
      "preview_urls": false,
      "assets": {
        "directory": "./dist",
        "html_handling": "auto-trailing-slash",
        "not_found_handling": "404-page"
      }
    }
  }
}
