#!/bin/sh
set -eu
cd "$(dirname "$0")/.."
if [ ! -x .venv/contracts/bin/python ]; then
  echo 'Run scripts/bootstrap first to prepare the contract validator.' >&2
  exit 1
fi
.venv/contracts/bin/python scripts/check-contracts.py
python3 scripts/check-localization.py
swift scripts/generate-app-icons.swift --check
python3 scripts/test-localization.py
swift format lint --strict apps/ios/Packages/FoldingKit/Package.swift
swift format lint --strict -r apps/ios/Packages/FoldingKit/Sources apps/ios/Packages/FoldingKit/Tests apps/ios/App apps/ios/BuildTests
tofu fmt -check -recursive infra
swift test --package-path apps/ios/Packages/FoldingKit
echo 'Personal core and contract checks passed. Backend, simulator and device checks are not included yet.'
