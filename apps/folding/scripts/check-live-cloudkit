#!/usr/bin/env python3
"""Run the opt-in, account-backed CloudKit journal probe on a signed-in simulator."""

import argparse
import json
import pathlib
import subprocess
import sys


ROOT = pathlib.Path(__file__).resolve().parents[1]


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("environment", choices=("production",))
    parser.add_argument("simulator", help="booted simulator UUID with an iCloud account")
    parser.add_argument(
        "--icloud-environment", choices=("Development", "Production"), default="Development"
    )
    args = parser.parse_args()
    identity = json.loads((ROOT / "fastlane/app-identifiers.json").read_text())[
        args.environment
    ]
    release = json.loads((ROOT / "fastlane/release-config.json").read_text())
    source = subprocess.check_output(
        ["git", "rev-parse", "HEAD"], cwd=ROOT, text=True
    ).strip()
    subprocess.run(
        ["xcodegen", "generate", "--spec", "apps/ios/project.yml", "--project", "apps/ios"],
        cwd=ROOT,
        check=True,
    )
    log = ROOT / "build" / f"live-cloudkit-{args.environment}-{args.icloud_environment.lower()}.log"
    log.parent.mkdir(parents=True, exist_ok=True)
    settings = {
        "DEVELOPMENT_TEAM": release["apple_team_id"],
        "FOLDING_APP_BUNDLE_ID": identity["bundle_id"],
        "FOLDING_WIDGET_BUNDLE_ID": identity["widget_bundle_id"],
        "FOLDING_APP_GROUP_IDENTIFIER": identity["app_group"],
        "FOLDING_CLOUD_CONTAINER_IDENTIFIER": identity["cloudkit_container"],
        "FOLDING_API_ORIGIN": (
            "https://api.getfolding.app"
        ),
        "FOLDING_ENVIRONMENT": args.environment,
        "FOLDING_SOURCE_COMMIT": source,
        "FOLDING_ICLOUD_ENVIRONMENT": args.icloud_environment,
        "FOLDING_ATTEST_ENVIRONMENT": "development",
        "FOLDING_APNS_ENVIRONMENT": "development",
        "FOLDING_SIMULATOR_ENTITLEMENTS": "Config/Folding.entitlements",
        "OTHER_SWIFT_FLAGS": "-DLIVE_CLOUDKIT_INTEGRATION",
    }
    command = [
        "xcodebuild", "-project", "apps/ios/Folding.xcodeproj", "-scheme", "Folding",
        "-configuration", "Debug", "-sdk", "iphonesimulator", "-destination",
        f"platform=iOS Simulator,id={args.simulator}", "-derivedDataPath",
        str(ROOT / "build/live-cloudkit" / args.environment / args.icloud_environment),
        "-only-testing:FoldingBuildTests/LiveCloudKitTests", "test",
        *(f"{key}={value}" for key, value in settings.items()),
    ]
    with log.open("w") as output:
        result = subprocess.run(command, cwd=ROOT, stdout=output, stderr=subprocess.STDOUT)
    transcript = log.read_text(errors="replace")
    passed = result.returncode == 0 and "Executed 1 test, with 0 failures" in transcript
    print(f"{'PASS' if passed else 'FAIL'}: {args.environment} CloudKit journal probe; log: {log}")
    return 0 if passed else 1


if __name__ == "__main__":
    sys.exit(main())
