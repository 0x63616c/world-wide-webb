{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://getfolding.app/contracts/v1/event-receipt.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "operation_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "request_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "received_at_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "event_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "disposition": {
            "enum": ["accepted", "duplicate", "quarantined", "rejected"]
          },
          "reason_code": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": ["event_id", "disposition", "reason_code"],
        "allOf": [
          {
            "if": {
              "properties": {
                "disposition": {
                  "enum": ["rejected", "quarantined"]
                }
              }
            },
            "then": {
              "properties": {
                "reason_code": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "operation_id",
    "request_id",
    "received_at_ms",
    "events"
  ]
}
