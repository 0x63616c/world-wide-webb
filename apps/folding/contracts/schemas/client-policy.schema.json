{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://getfolding.app/contracts/v1/client-policy.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "minimum_ios_build": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "request_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    }
  },
  "required": ["minimum_ios_build", "request_id"]
}
