{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://getfolding.app/contracts/v1/entry-deletion-receipt.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "operation_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "state": {
      "const": "completed"
    },
    "error_code": {
      "type": "null"
    },
    "request_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    }
  },
  "required": [
    "operation_id",
    "state",
    "error_code",
    "request_id"
  ]
}
