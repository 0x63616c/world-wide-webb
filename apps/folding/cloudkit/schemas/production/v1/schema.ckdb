DEFINE SCHEMA

    RECORD TYPE CD_ReplicatedEvent (
        CD_entityName           STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_generationID         STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_generationID_ckAsset ASSET,
        CD_generationRevision   INT64 QUERYABLE SORTABLE,
        CD_logicalID            STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_logicalID_ckAsset    ASSET,
        CD_moveReceipt          BYTES QUERYABLE SORTABLE,
        CD_moveReceipt_ckAsset  ASSET,
        CD_payload              BYTES QUERYABLE SORTABLE,
        CD_payload_ckAsset      ASSET,
        "___createTime"         TIMESTAMP,
        "___createdBy"          REFERENCE,
        "___etag"               STRING,
        "___modTime"            TIMESTAMP,
        "___modifiedBy"         REFERENCE,
        "___recordID"           REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_ResetMarker (
        CD_entityName          STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_logicalID           STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_logicalID_ckAsset   ASSET,
        CD_moveReceipt         BYTES QUERYABLE SORTABLE,
        CD_moveReceipt_ckAsset ASSET,
        CD_payload             BYTES QUERYABLE SORTABLE,
        CD_payload_ckAsset     ASSET,
        "___createTime"        TIMESTAMP,
        "___createdBy"         REFERENCE,
        "___etag"              STRING,
        "___modTime"           TIMESTAMP,
        "___modifiedBy"        REFERENCE,
        "___recordID"          REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_TrackingInterruption (
        CD_entityName           STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_generationID         STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_generationID_ckAsset ASSET,
        CD_generationRevision   INT64 QUERYABLE SORTABLE,
        CD_logicalID            STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_logicalID_ckAsset    ASSET,
        CD_moveReceipt          BYTES QUERYABLE SORTABLE,
        CD_moveReceipt_ckAsset  ASSET,
        CD_payload              BYTES QUERYABLE SORTABLE,
        CD_payload_ckAsset      ASSET,
        "___createTime"         TIMESTAMP,
        "___createdBy"          REFERENCE,
        "___etag"               STRING,
        "___modTime"            TIMESTAMP,
        "___modifiedBy"         REFERENCE,
        "___recordID"           REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_TransferMarker (
        CD_entityName          STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_logicalID           STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_logicalID_ckAsset   ASSET,
        CD_moveReceipt         BYTES QUERYABLE SORTABLE,
        CD_moveReceipt_ckAsset ASSET,
        CD_payload             BYTES QUERYABLE SORTABLE,
        CD_payload_ckAsset     ASSET,
        "___createTime"        TIMESTAMP,
        "___createdBy"         REFERENCE,
        "___etag"              STRING,
        "___modTime"           TIMESTAMP,
        "___modifiedBy"        REFERENCE,
        "___recordID"          REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE Users (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        roles           LIST<INT64>,
        GRANT WRITE TO "_creator",
        GRANT READ TO "_world"
    );
