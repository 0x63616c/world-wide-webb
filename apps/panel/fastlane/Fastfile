default_platform(:ios)

platform :ios do
  desc "Initialize match certificates (run locally once)"
  lane :init_match do
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_CONTENT"],
      is_key_content_base64: true
    )

    match(
      type: "appstore",
      api_key: api_key,
      readonly: false
    )
  end

  desc "Build and upload to TestFlight"
  lane :release do
    setup_ci

    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_CONTENT"],
      is_key_content_base64: true
    )

    # Normally readonly: CI must never mint or revoke signing assets as a side
    # effect of a routine build. But enabling/removing an App ID capability marks
    # every existing profile Invalid, and a readonly match happily installs the
    # stale cached copy , the build then succeeds while silently shipping a binary
    # without the new entitlement. (Exactly what happened when Push Notifications
    # was enabled: the profile went Invalid and the next build shipped with no
    # aps-environment.) Set MATCH_REGENERATE=true for ONE run after a capability
    # change; force: true regenerates the profile only and leaves certs alone.
    regenerate = ENV["MATCH_REGENERATE"] == "true"
    UI.important("MATCH_REGENERATE set , regenerating provisioning profile") if regenerate

    # match mints profiles but never App IDs, so a new target (the
    # NextAlarmWidget extension) fails with "Couldn't find bundle identifier"
    # until its App ID exists. Register any missing ones in the same one-off
    # regenerate run, never on a routine build. Keep in sync with Matchfile.
    if regenerate
      ["co.worldwidewebb.theworkflowengine", "co.worldwidewebb.theworkflowengine.NextAlarmWidget"].each do |identifier|
        next if Spaceship::ConnectAPI::BundleId.find(identifier)
        UI.important("Registering App ID #{identifier}")
        Spaceship::ConnectAPI::BundleId.create(
          name: identifier.split(".").last,
          platform: Spaceship::ConnectAPI::BundleIdPlatform::IOS,
          identifier: identifier
        )
      end
    end

    match(
      type: "appstore",
      api_key: api_key,
      readonly: !regenerate,
      force: regenerate
    )

    update_code_signing_settings(
      use_automatic_signing: false,
      path: "ios/ControlCenter.xcodeproj",
      targets: ["ControlCenter"],
      team_id: "X9E4HG27NK",
      bundle_identifier: "co.worldwidewebb.theworkflowengine",
      profile_name: ENV["sigh_co.worldwidewebb.theworkflowengine_appstore_profile-name"],
      code_sign_identity: "Apple Distribution"
    )

    update_code_signing_settings(
      use_automatic_signing: false,
      path: "ios/ControlCenter.xcodeproj",
      targets: ["NextAlarmWidget"],
      team_id: "X9E4HG27NK",
      bundle_identifier: "co.worldwidewebb.theworkflowengine.NextAlarmWidget",
      profile_name: ENV["sigh_co.worldwidewebb.theworkflowengine.NextAlarmWidget_appstore_profile-name"],
      code_sign_identity: "Apple Distribution"
    )

    # Derive the build number from TestFlight, not the CI run number. These builds
    # already exist on the original "Evee" TestFlight app (1.0, build 48+), but
    # control-center's GitHub run_number starts from 1 , using it would collide with
    # / regress below existing builds and App Store Connect would reject the upload.
    # latest_testflight_build_number + 1 is monotonic regardless of which repo ships.
    latest = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: "co.worldwidewebb.theworkflowengine",
      initial_build_number: 48
    )
    increment_build_number(
      build_number: latest + 1,
      xcodeproj: "ios/ControlCenter.xcodeproj"
    )

    build_app(
      workspace: "ios/ControlCenter.xcworkspace",
      project: nil,
      scheme: "ControlCenter",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "./build",
      output_name: "ControlCenter.ipa",
      clean: true,
      codesigning_identity: "Apple Distribution"
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: false,
      skip_submission: true
    )
  end

  desc "Build the native hybrid Panel and upload to the existing TestFlight app"
  lane :release_native do
    setup_ci
    native_root = File.expand_path(ENV.fetch("NATIVE_ROOT"))
    project = File.join(native_root, "WorldWideWebb.xcodeproj")
    identifier = "co.worldwidewebb.theworkflowengine"
    secrets_path = File.join(native_root, "Hybrid/Config/Secrets.xcconfig")

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_CONTENT"),
      is_key_content_base64: true
    )
    # The NextAlarmWidget extension (WWW-47) is signed only when the native ref has it.
    widget_target = "NextAlarmWidget"
    widget_identifier = "#{identifier}.NextAlarmWidget"
    has_widget = File.read(File.join(native_root, "project.yml")).match?(/^  #{widget_target}:\s*$/)
    identifiers = has_widget ? [identifier, widget_identifier] : [identifier]
    regenerate = ENV["MATCH_REGENERATE"] == "true"
    match(
      type: "appstore",
      app_identifier: identifiers,
      api_key: api_key,
      readonly: !regenerate,
      force: regenerate
    )

    # xcconfig treats // as a comment; the empty expansion preserves URL slashes.
    config = { "PANEL_SERVER_URL" => "https://app.worldwidewebb.co",
               "PANEL_CF_ACCESS_CLIENT_ID" => ENV.fetch("CF_ACCESS_KIOSK_CLIENT_ID"),
               "PANEL_CF_ACCESS_CLIENT_SECRET" => ENV.fetch("CF_ACCESS_KIOSK_CLIENT_SECRET"),
               "PANEL_ALARM_API_TOKEN" => ENV.fetch("ALARM_API_TOKEN") }
    config.each_value do |value|
      UI.user_error!("Panel configuration must be a single literal line") if value.match?(/[\r\n$]/)
    end
    begin
      File.open(secrets_path, "w", 0600) do |file|
        config.each { |key, value| file.puts "#{key} = #{value.gsub('/', '/$()')}" }
      end
      Dir.chdir(native_root) { sh("xcodegen", "generate") }
      update_code_signing_settings(
        use_automatic_signing: false,
        path: project,
        targets: ["Panel"],
        team_id: "X9E4HG27NK",
        bundle_identifier: identifier,
        profile_name: ENV.fetch("sigh_#{identifier}_appstore_profile-name"),
        code_sign_identity: "Apple Distribution"
      )
      if has_widget
        update_code_signing_settings(
          use_automatic_signing: false,
          path: project,
          targets: [widget_target],
          team_id: "X9E4HG27NK",
          bundle_identifier: widget_identifier,
          profile_name: ENV.fetch("sigh_#{widget_identifier}_appstore_profile-name"),
          code_sign_identity: "Apple Distribution"
        )
      end
      profiles = identifiers.to_h { |id| [id, ENV.fetch("sigh_#{id}_appstore_profile-name")] }

      # Use the same marketing version as the Expo app, not the prototype's 0.1.0.
      expo_config = File.read(File.expand_path("../app.config.ts", __dir__))
      version = expo_config[/^\s*version:\s*"([0-9]+(?:\.[0-9]+){1,2})"/, 1]
      UI.user_error!("Cannot read Expo marketing version from app.config.ts") unless version
      latest = latest_testflight_build_number(
        api_key: api_key,
        app_identifier: identifier,
        version: version,
        initial_build_number: 48
      )
      # Command-line signing also reaches the local PanelKit package, which needs a team.
      build_app(
        project: project,
        scheme: "Panel",
        configuration: "Release",
        export_method: "app-store",
        export_options: { provisioningProfiles: profiles },
        xcargs: "CODE_SIGNING_ALLOWED=YES DEVELOPMENT_TEAM=X9E4HG27NK CURRENT_PROJECT_VERSION=#{latest + 1} MARKETING_VERSION=#{version}",
        output_directory: "./build",
        output_name: "Panel.ipa",
        # Targets are signed above; a command-line identity would also hit the
        # automatically signed local PanelKit package and fail the archive.
        clean: true
      )
      upload_to_testflight(
        api_key: api_key,
        # Keep the shared upload lock until ASC exposes the new number to
        # latest_testflight_build_number in the next queued native/Expo release.
        skip_waiting_for_build_processing: false,
        skip_submission: true
      )
      # Publish only after upload succeeds; use the exact archive build.
      if ENV["GITHUB_ENV"]
        File.open(ENV.fetch("GITHUB_ENV"), "a") { |file| file.puts "PANEL_UPLOADED_BUILD=#{latest + 1}" }
      end
    ensure
      File.delete(secrets_path) if File.exist?(secrets_path)
    end
  end
end
