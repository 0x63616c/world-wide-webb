    "travel.explanation": {
      "comment": "Explain that travel is a derived full-swing equivalent, not sensor measurement. Non-English copy is an AI draft; see docs/localization.md for QA status.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A playful full-swing equivalent based on your recorded folds, not measured movement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein spielerischer Wert aus deinen Faltungen, der volle Scharnierbewegungen annimmt. Keine gemessene Bewegung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une estimation ludique en mouvements complets, calculée à partir de vos pliages, et non une mesure réelle."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una equivalencia lúdica de recorridos completos basada en tus pliegues, no en movimientos medidos."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Una equivalencia lúdica de recorridos completos basada en tus pliegues, no en movimientos medidos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録した折りたたみを全開閉に換算した楽しい目安です。実際の動きを測定したものではありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기록된 폴딩을 완전한 개폐 동작으로 환산한 재미용 수치로, 실제 움직임을 측정한 값은 아닙니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma equivalência lúdica de movimentos completos baseada nas suas dobras, não em movimentos medidos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "根据折叠记录换算完整开合行程的趣味数值，并非实际测量的移动距离。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "根據摺疊記錄換算完整開闔行程的趣味數值，並非實際測量的移動距離。"
          }
        }
      }
    },
