+func RemoveProfiles(bootEntryProfilePaths []string) {
+	if runtime.GOOS == "darwin" {
+		if err := removeDarwinProfiles("/nix/var/nix/profiles", "/run/current-system", bootEntryProfilePaths); err != nil {
+			logrus.Errorf("profile: retaining Darwin profiles because current state could not be verified: %s", err)
+		}
+		return
+	}
+	removeProfiles(systemProfiles, profileName, bootEntryProfilePaths)
+}
+
+// Darwin's activation daemon and boot read the standard system profile.
+// Its shared parent also contains unrelated profiles, which must never be pruned.
+func isDarwinGeneration(name string) bool {
+	digits := strings.TrimSuffix(strings.TrimPrefix(name, "system-"), "-link")
+	if name != "system-"+digits+"-link" || digits == "" {
+		return false
+	}
+	for _, digit := range digits {
+		if digit < '0' || digit > '9' {
+			return false
+		}
+	}
+	number, err := strconv.ParseUint(digits, 10, 32)
+	return err == nil && number > 0 && strconv.FormatUint(number, 10) == digits
+}
+
+func removeDarwinProfiles(directory, currentSystem string, retained []string) error {
+	active, err := filepath.EvalSymlinks(currentSystem)
+	if err != nil {
+		return err
+	}
+	if info, err := os.Stat(active); err != nil || !info.IsDir() {
+		return fmt.Errorf("current system is not a directory")
+	}
+	target, err := os.Readlink(filepath.Join(directory, "system"))
+	if err != nil {
+		return err
+	}
+	originalTarget := target
+	if !filepath.IsAbs(target) {
+		target = filepath.Join(directory, target)
+	}
+	target = filepath.Clean(target)
+	if filepath.Dir(target) != directory || !isDarwinGeneration(filepath.Base(target)) {
+		return fmt.Errorf("unexpected default profile target")
+	}
+	resolved, err := filepath.EvalSymlinks(target)
+	if err != nil {
+		return err
+	}
+	if info, err := os.Stat(resolved); err != nil || !info.IsDir() {
+		return fmt.Errorf("default system is not a directory")
+	}
+	entries, err := os.ReadDir(directory)
+	if err != nil {
+		return err
+	}
+	var obsolete []string
+	for _, entry := range entries {
+		if !isDarwinGeneration(entry.Name()) || entry.Type()&os.ModeSymlink == 0 {
+			continue
+		}
+		candidate := filepath.Join(directory, entry.Name())
+		if candidate == target || slices.Contains(retained, candidate) {
+			continue
+		}
+		destination, err := filepath.EvalSymlinks(candidate)
+		if err != nil || destination == active {
+			continue
+		}
+		// Preserve malformed entries rather than treating them as generations.
+		info, err := os.Stat(destination)
+		if err != nil || !info.IsDir() {
+			continue
+		}
+		obsolete = append(obsolete, strings.TrimSuffix(strings.TrimPrefix(entry.Name(), "system-"), "-link"))
+	}
+	latestActive, err := filepath.EvalSymlinks(currentSystem)
+	if err != nil || latestActive != active {
+		return fmt.Errorf("current system changed during retention check")
+	}
+	latestTarget, err := os.Readlink(filepath.Join(directory, "system"))
+	if err != nil || latestTarget != originalTarget {
+		return fmt.Errorf("default profile changed during retention check")
+	}
+	if len(obsolete) == 0 {
+		return nil
+	}
+	// Nix holds its profile lock and rechecks the current generation before
+	// deletion, including when another native switch follows our snapshot.
+	args := append([]string{"--profile", filepath.Join(directory, "system"), "--delete-generations"}, obsolete...)
+	cmd := exec.Command("nix-env", args...)
+	cmd.Stdout, cmd.Stderr = os.Stdout, os.Stderr
+	return cmd.Run()
 }
 
