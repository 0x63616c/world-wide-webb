{
  "$defs": {
    "Deployment": {
      "additionalProperties": false,
      "description": "The authoring branch discovers this policy; only the deployment branch installs hosts.",
      "properties": {
        "branch": {
          "pattern": "^deploy/homelab$",
          "type": "string"
        },
        "repository": {
          "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]{0,99}/[A-Za-z0-9_][A-Za-z0-9_.-]{0,99}$",
          "type": "string"
        }
      },
      "required": [
        "repository",
        "branch"
      ],
      "type": "object"
    },
    "Host": {
      "additionalProperties": false,
      "properties": {
        "adminUID": {
          "description": "Existing administrator UID, verified against the target before setup.",
          "format": "uint32",
          "maximum": 4294967295,
          "minimum": 501,
          "type": "integer"
        },
        "adminUser": {
          "description": "Existing administrator account; setup never guesses or renames this user.",
          "maxLength": 253,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._][A-Za-z0-9._-]*$",
          "type": "string"
        },
        "authorizedKeys": {
          "description": "Public SSH keys only, never private keys.",
          "items": {
            "maxLength": 8192,
            "minLength": 1,
            "pattern": "^(?=.*\\S)[^\\x00-\\x1F\\x7F-\\x9F]+$",
            "type": "string"
          },
          "maxItems": 32,
          "type": "array"
        },
        "services": {
          "description": "Names of services the target configuration must enable.",
          "items": {
            "maxLength": 253,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._][A-Za-z0-9._-]*$",
            "type": "string"
          },
          "maxItems": 32,
          "type": "array"
        }
      },
      "required": [
        "adminUser",
        "adminUID",
        "authorizedKeys",
        "services"
      ],
      "type": "object"
    },
    "OAuthReference": {
      "additionalProperties": false,
      "properties": {
        "item": {
          "description": "1Password item reference; no OAuth secret belongs in this document.",
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^(?!-)(?=.*\\S)[^\\x00-\\x1F\\x7F-\\x9F]+$",
          "type": "string"
        },
        "vault": {
          "description": "1Password vault containing the OAuth issuer item; not the backup destination.",
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^(?!-)(?=.*\\S)[^\\x00-\\x1F\\x7F-\\x9F]+$",
          "type": "string"
        }
      },
      "required": [
        "vault",
        "item"
      ],
      "type": "object"
    },
    "OnePasswordConfig": {
      "additionalProperties": false,
      "properties": {
        "backupVault": {
          "description": "Vault where host and recovery age identities are durably backed up.\nThis is independent of tailscale.oauth.vault, which contains the issuer.",
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^(?!-)(?=.*\\S)[^\\x00-\\x1F\\x7F-\\x9F]+$",
          "type": "string"
        }
      },
      "required": [
        "backupVault"
      ],
      "type": "object"
    },
    "TailscaleConfig": {
      "additionalProperties": false,
      "properties": {
        "oauth": {
          "anyOf": [
            {
              "$ref": "#/$defs/OAuthReference"
            },
            {
              "type": "null"
            }
          ]
        },
        "tag": {
          "description": "Tailscale device tag used for this enrollment.",
          "pattern": "^tag:[a-z]([a-z0-9-]{0,61}[a-z0-9])?$",
          "type": "string"
        }
      },
      "required": [
        "tag"
      ],
      "type": "object"
    }
  },
  "$id": "urn:homelab:configuration:v3",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "description": "Inert editor metadata. The CLI never fetches this URL.",
      "type": [
        "string",
        "null"
      ]
    },
    "deployment": {
      "$ref": "#/$defs/Deployment"
    },
    "hosts": {
      "additionalProperties": {
        "$ref": "#/$defs/Host"
      },
      "maxProperties": 32,
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z]([a-z0-9-]{0,61}[a-z0-9])?$"
      },
      "type": "object"
    },
    "onePassword": {
      "$ref": "#/$defs/OnePasswordConfig"
    },
    "schema": {
      "const": 3,
      "description": "Current configuration version."
    },
    "tailscale": {
      "anyOf": [
        {
          "$ref": "#/$defs/TailscaleConfig"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema",
    "hosts",
    "deployment",
    "onePassword"
  ],
  "title": "Manifest",
  "type": "object"
}
