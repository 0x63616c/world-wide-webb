{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://getfolding.app/contracts/v1/auth-refresh-request.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "operation_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "refresh_token": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    }
  },
  "required": ["operation_id", "refresh_token"]
}
