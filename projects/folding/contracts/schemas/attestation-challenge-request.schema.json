{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://getfolding.app/contracts/v1/attestation-challenge-request.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "purpose": {
      "enum": [
        "enroll_key",
        "join",
        "transfer",
        "submit_events",
        "reset",
        "avatar_upload"
      ]
    },
    "device_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "key_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9+/]{43}=$"
    }
  },
  "required": ["purpose", "device_id", "key_id"]
}
